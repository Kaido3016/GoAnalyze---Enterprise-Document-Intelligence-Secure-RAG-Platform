
# --- Application -------------------------------------------------------
# development | staging | production
GOV_ENVIRONMENT=development
# Must be a strong, unique value in staging/production. The app refuses to
# start in production if this is left unset or at any known-insecure value.
GOV_AUDIT_HASH_SECRET=
# Only ever set to "true" for local development. The app refuses to start
# in production if this is enabled.
GOV_ALLOW_INSECURE_DEV_AUTH=false
GOV_KEYCLOAK_ISSUER=http://keycloak:8080/realms/goanalyze
GOV_KEYCLOAK_AUDIENCE=goanalyze-api
# Optional: override the derived "<issuer>/protocol/openid-connect/certs"
# JWKS URL if your identity provider uses a non-standard discovery layout.
GOV_KEYCLOAK_JWKS_URL=
# Required. JSON array of allowed CORS origins, e.g. ["https://goanalyze.example.gov"]
GOV_ALLOWED_ORIGINS=["http://localhost:3000"]

# --- Rate limiting (Redis-backed) -----------------------------------------
GOV_RATE_LIMIT_ENABLED=true
GOV_RATE_LIMIT_PER_IP_PER_MINUTE=120
GOV_RATE_LIMIT_PER_USER_PER_MINUTE=300
GOV_RATE_LIMIT_PER_TENANT_PER_MINUTE=1000

# --- Database connection pool ---------------------------------------------
GOV_DATABASE_POOL_SIZE=10
GOV_DATABASE_MAX_OVERFLOW=20
GOV_DATABASE_POOL_TIMEOUT_SECONDS=30

# --- Search (OpenSearch, with automatic database fallback) ---------------
GOV_OPENSEARCH_INDEX=goanalyze-documents

# --- Object storage (durable MinIO/S3; no silent in-memory fallback) --------
GOV_MINIO_ENDPOINT=minio:9000
GOV_ALLOW_IN_MEMORY_STORAGE_FALLBACK=false
GOV_MINIO_ACCESS_KEY=
GOV_MINIO_SECRET_KEY=
GOV_MINIO_BUCKET=goanalyze-documents
GOV_MINIO_SECURE=false

# --- Tracing (OpenTelemetry) ----------------------------------------------
GOV_OTEL_TRACING_ENABLED=true
# If unset, spans are exported to the console in development and not
# exported at all outside development. Set this to ship spans via OTLP.
GOV_OTEL_EXPORTER_OTLP_ENDPOINT=

# --- PostgreSQL ----------------------------------------------------------
POSTGRES_USER=goanalyze
POSTGRES_PASSWORD=<secret>
POSTGRES_DB=goanalyze

# --- MinIO -----------------------------------------------------------
MINIO_ROOT_USER=goanalyze
MINIO_ROOT_PASSWORD=<secret>

# --- OpenSearch --------------------------------------------------------
OPENSEARCH_INITIAL_ADMIN_PASSWORD=<secret>

# --- Keycloak ----------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=<secret>

# --- Grafana -------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<secret>

# --- AI providers (OpenAI-compatible; leave blank to disable RAG) ---------
GOV_EMBEDDING_BASE_URL=
GOV_EMBEDDING_API_KEY=
GOV_EMBEDDING_MODEL=text-embedding-3-small
GOV_LLM_BASE_URL=
GOV_LLM_API_KEY=
GOV_LLM_MODEL=gpt-4.1-mini
GOV_RAG_TOP_K=5
GOV_RAG_MIN_SIMILARITY=0.15

# --- Frontend ------------------------------------------------------------
NEXT_PUBLIC_GOV_API_URL=http://localhost:8080
